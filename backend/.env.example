# Telegram
TELEGRAM_BOT_TOKEN=
# Segredo validado no header X-Telegram-Bot-Api-Secret-Token do webhook
TELEGRAM_WEBHOOK_SECRET=um-segredo-longo-e-aleatorio
# URL pública do backend (usada no setWebhook) e do site de onboarding
APP_BASE_URL=https://seu-backend.exemplo.com
SITE_URL=https://faleiepronto.com.br
TELEGRAM_SET_WEBHOOK=true

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase (service role — nunca exponha no front)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fuso para "hoje", limites de mês e formatação
TZ=America/Sao_Paulo
PORT=3000

# Opcional: notificação de cancelamento (paridade com o n8n)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
